<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SilentStream.Inspection.Coordinator</RootNamespace>
    <AssemblyName>SilentStreamInspectionCoordinator</AssemblyName>
    <OutputType>WinExe</OutputType>
    <Version>0.4.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="7.0.2" />
    <ProjectReference Include="..\SilentStream.Inspection.Contracts\SilentStream.Inspection.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
