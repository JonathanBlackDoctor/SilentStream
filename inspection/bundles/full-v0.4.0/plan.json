{
  "name": "SilentStream 전체 원격 실기기 점검 v0.4.0",
  "steps": [
    { "id":"preflight", "type":"script", "timeoutSeconds":120, "input":{ "path":"scripts/preflight.ps1" } },
    { "id":"backup-config", "type":"script", "dependsOn":["preflight"], "timeoutSeconds":120, "input":{ "path":"scripts/backup-config.ps1", "destructive":true } },
    { "id":"collect-system", "type":"collect", "dependsOn":["preflight"], "timeoutSeconds":60, "input":{} },
    { "id":"desktop-before", "type":"desktopProbe", "dependsOn":["preflight"], "timeoutSeconds":45, "input":{ "monitor":0, "audioPhysical":true, "destructive":true } },
    { "id":"app-status-before", "type":"appApi", "dependsOn":["backup-config"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"ensure-idle", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":90, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/live/stop", "expectedStatus":200, "destructive":true } },
    { "id":"prepare-private-test", "type":"script", "dependsOn":["ensure-idle"], "timeoutSeconds":60, "input":{ "path":"scripts/prepare-private-test.ps1", "destructive":true } },
    { "id":"unlock-settings", "type":"appApi", "dependsOn":["prepare-private-test"], "timeoutSeconds":30, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/settings-lock", "expectedStatus":200, "destructive":true, "body":{ "mode":"unlocked" } } },
    { "id":"diagnostics-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/diagnostics", "expectedStatus":200 } },
    { "id":"audio-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/audio", "expectedStatus":200 } },
    { "id":"audio-hardware", "type":"script", "dependsOn":["audio-before"], "timeoutSeconds":120, "input":{ "path":"scripts/audio-hardware.ps1" } },
    { "id":"schedule-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/schedule/today", "expectedStatus":200 } },
    { "id":"splits-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/splits", "expectedStatus":200 } },
    { "id":"quality-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200 } },
    { "id":"recovery-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/recovery/status", "expectedStatus":200 } },
    { "id":"push-before", "type":"appApi", "dependsOn":["app-status-before"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/push/vapid", "expectedStatus":200 } },
    { "id":"live-start", "type":"appApi", "dependsOn":["unlock-settings","diagnostics-before","audio-hardware","schedule-before","quality-before","recovery-before","push-before"], "timeoutSeconds":90, "retry":1, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/live/start", "expectedStatus":200, "destructive":true } },
    { "id":"live-warmup", "type":"wait", "dependsOn":["live-start"], "timeoutSeconds":70, "input":{ "seconds":45 } },
    { "id":"live-status", "type":"appApi", "dependsOn":["live-warmup"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"notification-trigger", "type":"appApi", "dependsOn":["live-status"], "timeoutSeconds":30, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/inspection/report", "expectedStatus":200, "body":{ "runId":"{{runId}}", "room":"{{room}}", "phase":"notification-test", "progressPercent":20, "currentStep":"external-notification", "message":"원격 점검 수신 확인 알림", "severity":"error", "recentLog":[], "issues":["notification-ack-required"], "rerunCount":0 } } },
    { "id":"telegram-ack", "type":"checkpoint", "dependsOn":["notification-trigger"], "timeoutSeconds":300, "input":{ "ack":"telegram" } },
    { "id":"webpush-ack", "type":"checkpoint", "dependsOn":["notification-trigger"], "timeoutSeconds":300, "input":{ "ack":"webpush" } },
    { "id":"quality-1", "type":"appApi", "dependsOn":["telegram-ack","webpush-ack"], "timeoutSeconds":60, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200, "body":{ "mode":"manual", "level":1 } } },
    { "id":"quality-1-wait", "type":"wait", "dependsOn":["quality-1"], "timeoutSeconds":30, "input":{ "seconds":12 } },
    { "id":"quality-2", "type":"appApi", "dependsOn":["quality-1-wait"], "timeoutSeconds":60, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200, "body":{ "mode":"manual", "level":2 } } },
    { "id":"quality-2-wait", "type":"wait", "dependsOn":["quality-2"], "timeoutSeconds":30, "input":{ "seconds":12 } },
    { "id":"quality-3", "type":"appApi", "dependsOn":["quality-2-wait"], "timeoutSeconds":60, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200, "body":{ "mode":"manual", "level":3 } } },
    { "id":"quality-3-wait", "type":"wait", "dependsOn":["quality-3"], "timeoutSeconds":30, "input":{ "seconds":12 } },
    { "id":"quality-0", "type":"appApi", "dependsOn":["quality-3-wait"], "timeoutSeconds":60, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200, "body":{ "mode":"manual", "level":0 } } },
    { "id":"quality-0-wait", "type":"wait", "dependsOn":["quality-0"], "timeoutSeconds":30, "input":{ "seconds":12 } },
    { "id":"quality-auto", "type":"appApi", "dependsOn":["quality-0-wait"], "timeoutSeconds":60, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200, "body":{ "mode":"auto" } } },
    { "id":"schedule-inject", "type":"appApi", "dependsOn":["quality-auto"], "timeoutSeconds":30, "input":{ "method":"PUT", "url":"http://127.0.0.1:8787/api/schedule/today", "expectedStatus":200, "destructive":true, "body":[ {"no":91,"start":"{{local+5s:HH:mm:ss}}","end":"{{local+25s:HH:mm:ss}}"}, {"no":92,"start":"{{local+30s:HH:mm:ss}}","end":"{{local+50s:HH:mm:ss}}"}, {"no":93,"start":"{{local+55s:HH:mm:ss}}","end":"{{local+75s:HH:mm:ss}}"}, {"no":94,"start":"{{local+80s:HH:mm:ss}}","end":"{{local+100s:HH:mm:ss}}"} ] } },
    { "id":"period-1-wait", "type":"wait", "dependsOn":["schedule-inject"], "timeoutSeconds":45, "input":{ "seconds":30 } },
    { "id":"splits-first", "type":"appApi", "dependsOn":["period-1-wait"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/splits", "expectedStatus":200 } },
    { "id":"split-approve-adjusted", "type":"appApi", "dependsOn":["splits-first"], "timeoutSeconds":60, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/splits/{{step:splits-first:body.pending.0.id}}/approve", "expectedStatus":200, "destructive":true, "body":{ "start":"{{stepDate:splits-first:body.pending.0.start:1}}", "end":"{{stepDate:splits-first:body.pending.0.end:-1}}" } } },
    { "id":"period-2-wait", "type":"wait", "dependsOn":["split-approve-adjusted"], "timeoutSeconds":45, "input":{ "seconds":28 } },
    { "id":"splits-second", "type":"appApi", "dependsOn":["period-2-wait"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/splits", "expectedStatus":200 } },
    { "id":"split-merge", "type":"appApi", "dependsOn":["splits-second"], "timeoutSeconds":60, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/splits/{{step:splits-second:body.pending.0.id}}/merge", "expectedStatus":200, "destructive":true } },
    { "id":"period-3-wait", "type":"wait", "dependsOn":["split-merge"], "timeoutSeconds":45, "input":{ "seconds":25 } },
    { "id":"split-merge-finish", "type":"appApi", "dependsOn":["period-3-wait"], "timeoutSeconds":60, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/splits/cancel-merge", "expectedStatus":200, "destructive":true } },
    { "id":"period-4-wait", "type":"wait", "dependsOn":["split-merge-finish"], "timeoutSeconds":50, "input":{ "seconds":30 } },
    { "id":"splits-fourth", "type":"appApi", "dependsOn":["period-4-wait"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/splits", "expectedStatus":200 } },
    { "id":"split-skip", "type":"appApi", "dependsOn":["splits-fourth"], "timeoutSeconds":60, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/splits/{{step:splits-fourth:body.pending.0.id}}/skip", "expectedStatus":200, "destructive":true } },
    { "id":"ffmpeg-fault", "type":"fault", "dependsOn":["split-skip"], "timeoutSeconds":30, "input":{ "action":"kill-process", "payload":{ "name":"ffmpeg" } } },
    { "id":"ffmpeg-recovery-wait", "type":"wait", "dependsOn":["ffmpeg-fault"], "timeoutSeconds":70, "input":{ "seconds":45 } },
    { "id":"status-after-ffmpeg", "type":"appApi", "dependsOn":["ffmpeg-recovery-wait"], "timeoutSeconds":30, "retry":2, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"recording-integrity", "type":"script", "dependsOn":["status-after-ffmpeg"], "timeoutSeconds":180, "input":{ "path":"scripts/recording-integrity.ps1" } },
    { "id":"live-stop", "type":"appApi", "dependsOn":["recording-integrity"], "timeoutSeconds":90, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/live/stop", "expectedStatus":200, "destructive":true } },
    { "id":"app-kill", "type":"fault", "dependsOn":["live-stop"], "timeoutSeconds":30, "input":{ "action":"kill-process", "payload":{ "name":"MediaCaptureHelper" } } },
    { "id":"app-restart", "type":"privileged", "dependsOn":["app-kill"], "timeoutSeconds":30, "input":{ "action":"restart-app", "payload":{} } },
    { "id":"app-restart-wait", "type":"wait", "dependsOn":["app-restart"], "timeoutSeconds":60, "input":{ "seconds":20 } },
    { "id":"app-after-restart", "type":"appApi", "dependsOn":["app-restart-wait"], "timeoutSeconds":30, "retry":3, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"tunnel-fault", "type":"fault", "dependsOn":["app-after-restart"], "timeoutSeconds":30, "input":{ "action":"restart-cloudflared", "payload":{} } },
    { "id":"tunnel-recovery-wait", "type":"wait", "dependsOn":["tunnel-fault"], "timeoutSeconds":60, "input":{ "seconds":20 } },
    { "id":"nic-bounce", "type":"privileged", "dependsOn":["tunnel-recovery-wait"], "timeoutSeconds":360, "input":{ "action":"nic-bounce", "payload":{ "adapter":"$active", "disableSeconds":20 } } },
    { "id":"network-recovery-wait", "type":"wait", "dependsOn":["nic-bounce"], "timeoutSeconds":60, "input":{ "seconds":20 } },
    { "id":"app-after-network", "type":"appApi", "dependsOn":["network-recovery-wait"], "timeoutSeconds":30, "retry":2, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"quality-after-network", "type":"appApi", "dependsOn":["app-after-network"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/quality", "expectedStatus":200 } },
    { "id":"reboot", "type":"privileged", "dependsOn":["quality-after-network"], "timeoutSeconds":360, "input":{ "action":"reboot", "payload":{} } },
    { "id":"reboot-settle", "type":"wait", "dependsOn":["reboot"], "timeoutSeconds":180, "input":{ "seconds":120 } },
    { "id":"desktop-after-reboot", "type":"desktopProbe", "dependsOn":["reboot-settle"], "timeoutSeconds":30, "input":{ "monitor":0 } },
    { "id":"app-after-reboot", "type":"appApi", "dependsOn":["reboot-settle"], "timeoutSeconds":30, "retry":3, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"uninstall-app", "type":"privileged", "dependsOn":["desktop-after-reboot","app-after-reboot"], "timeoutSeconds":600, "input":{ "action":"uninstall-app", "payload":{} } },
    { "id":"uninstall-settle", "type":"wait", "dependsOn":["uninstall-app"], "timeoutSeconds":60, "input":{ "seconds":20 } },
    { "id":"install-app", "type":"privileged", "dependsOn":["uninstall-settle"], "timeoutSeconds":360, "input":{ "action":"install-app", "payload":{} } },
    { "id":"install-settle", "type":"wait", "dependsOn":["install-app"], "timeoutSeconds":90, "input":{ "seconds":45 } },
    { "id":"app-after-install", "type":"appApi", "dependsOn":["install-settle"], "timeoutSeconds":30, "retry":3, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } },
    { "id":"live-start-stability", "type":"appApi", "dependsOn":["app-after-install"], "timeoutSeconds":90, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/live/start", "expectedStatus":200, "destructive":true } },
    { "id":"stability-75m-a", "type":"wait", "dependsOn":["live-start-stability"], "timeoutSeconds":4560, "input":{ "seconds":4500 } },
    { "id":"stability-midpoint", "type":"appApi", "dependsOn":["stability-75m-a"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/diagnostics", "expectedStatus":200 } },
    { "id":"stability-75m-b", "type":"wait", "dependsOn":["stability-midpoint"], "timeoutSeconds":4560, "input":{ "seconds":4500 } },
    { "id":"stability-final", "type":"appApi", "dependsOn":["stability-75m-b"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/diagnostics", "expectedStatus":200 } },
    { "id":"period-assets-final", "type":"appApi", "dependsOn":["stability-final"], "timeoutSeconds":30, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/period-assets", "expectedStatus":200 } },
    { "id":"live-stop-final", "type":"appApi", "dependsOn":["period-assets-final"], "timeoutSeconds":90, "input":{ "method":"POST", "url":"http://127.0.0.1:8787/api/live/stop", "expectedStatus":200, "destructive":true } },
    { "id":"restore-config", "type":"cleanup", "dependsOn":["live-stop-final"], "required":true, "timeoutSeconds":120, "input":{ "path":"scripts/restore-config.ps1" } },
    { "id":"restart-after-cleanup", "type":"cleanup", "dependsOn":["restore-config"], "required":true, "timeoutSeconds":30, "input":{ "action":"restart-app", "payload":{} } },
    { "id":"postflight-wait", "type":"wait", "dependsOn":["restart-after-cleanup"], "timeoutSeconds":60, "input":{ "seconds":20 } },
    { "id":"postflight", "type":"script", "dependsOn":["postflight-wait"], "timeoutSeconds":120, "input":{ "path":"scripts/postflight.ps1" } },
    { "id":"app-status-final", "type":"appApi", "dependsOn":["postflight"], "timeoutSeconds":30, "retry":2, "input":{ "method":"GET", "url":"http://127.0.0.1:8787/api/status", "expectedStatus":200 } }
  ]
}
