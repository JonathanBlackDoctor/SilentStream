{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silentstream-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "silentstream.win/*", "zone_name": "silentstream.win" },
    { "pattern": "www.silentstream.win/*", "zone_name": "silentstream.win" },
    { "pattern": "admin.silentstream.win", "custom_domain": true },
    { "pattern": "agent.silentstream.win", "custom_domain": true },
    { "pattern": "m111.silentstream.win", "custom_domain": true },
    { "pattern": "m112.silentstream.win", "custom_domain": true },
    { "pattern": "m113.silentstream.win", "custom_domain": true },
    { "pattern": "baek202.silentstream.win", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlPlane" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlPlane"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URI": "https://admin.silentstream.win",
    "DEVICE_BASE_URI": "https://agent.silentstream.win",
    "PACKAGE_KEY": "releases/v0.4.1-hotfix1/SilentStream-prepared-package.zip",
    "PACKAGE_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/silentstream-control-v0.4.1/SilentStream-prepared-package-v0.4.1-hotfix1.zip",
    "PACKAGE_SHA256": "3b94a714d764a854517c5495d0d12ab652fe27924511e1448b956ae9340dd340",
    "PACKAGE_LENGTH": "514386672",
    "INSTALLER_KEY": "releases/v0.4.1-hotfix2/SilentStream-Central-Installer.exe",
    "INSTALLER_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/silentstream-control-v0.4.1/SilentStream-Central-Installer-v0.4.1-hotfix2.exe",
    "INSTALLER_SHA256": "4337c57d6d1f18bec60daefde278491156376aad12f695dd848ca65e504e1e1c",
    "INSTALLER_LENGTH": "161710377",
    "GOOGLE_CLIENT_ID": "909291792658-um7mnfcnu8po4d36hs6n09q6inssc654.apps.googleusercontent.com",
    "BOOTSTRAP_OWNER_EMAIL": "alpaomegastartend@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
