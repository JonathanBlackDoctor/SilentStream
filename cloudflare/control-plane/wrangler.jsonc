{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silentstream-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "www.silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "admin.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "agent.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m111.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m112.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m113.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "baek202.silentstream.win",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URI": "https://admin.silentstream.win",
    "DEVICE_BASE_URI": "https://agent.silentstream.win",
    "PACKAGE_KEY": "releases/v0.4.12/SilentStream-prepared-package-v0.4.12.zip",
    "PACKAGE_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.12/SilentStream-prepared-package-v0.4.12.zip",
    "PACKAGE_SHA256": "162586aa72fd743f38a73970572df691f9daa4e39891b553c2266dd881aa19b6",
    "PACKAGE_LENGTH": "802275555",
    "INSTALLER_KEY": "releases/v0.4.12/SilentStream-Central-Installer-v0.4.12.exe",
    "INSTALLER_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.12/SilentStream-Central-Installer-v0.4.12.exe",
    "INSTALLER_SHA256": "ca4f4bbdf47b4a23c0651996f51e42ac94ffb03d320ad5916100397500c80a45",
    "INSTALLER_LENGTH": "161754969",
    "GOOGLE_CLIENT_ID": "909291792658-um7mnfcnu8po4d36hs6n09q6inssc654.apps.googleusercontent.com",
    "BOOTSTRAP_OWNER_EMAIL": "alpaomegastartend@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
