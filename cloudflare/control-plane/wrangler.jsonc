{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silentstream-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "silentstream.win/*", "zone_name": "silentstream.win" },
    { "pattern": "www.silentstream.win/*", "zone_name": "silentstream.win" },
    { "pattern": "admin.silentstream.win", "custom_domain": true },
    { "pattern": "agent.silentstream.win", "custom_domain": true },
    { "pattern": "m111.silentstream.win", "custom_domain": true },
    { "pattern": "m112.silentstream.win", "custom_domain": true },
    { "pattern": "m113.silentstream.win", "custom_domain": true },
    { "pattern": "baek202.silentstream.win", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlPlane" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlPlane"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URI": "https://admin.silentstream.win",
    "DEVICE_BASE_URI": "https://agent.silentstream.win",
    "PACKAGE_KEY": "releases/v0.4.1-hotfix3/SilentStream-prepared-package.zip",
    "PACKAGE_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/silentstream-control-v0.4.1/SilentStream-prepared-package-v0.4.1-hotfix3.zip",
    "PACKAGE_SHA256": "78508203ab751f22b394082fd381e5927430e575cfc8f06b3bb7005c01d4d198",
    "PACKAGE_LENGTH": "514388119",
    "INSTALLER_KEY": "releases/v0.4.1-hotfix3/SilentStream-Central-Installer.exe",
    "INSTALLER_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/silentstream-control-v0.4.1/SilentStream-Central-Installer-v0.4.1-hotfix3.exe",
    "INSTALLER_SHA256": "496963496d21f179c4a568c44b8d2bcd602f8fa7a8c69091b217b458981149b7",
    "INSTALLER_LENGTH": "161714473",
    "GOOGLE_CLIENT_ID": "909291792658-um7mnfcnu8po4d36hs6n09q6inssc654.apps.googleusercontent.com",
    "BOOTSTRAP_OWNER_EMAIL": "alpaomegastartend@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
