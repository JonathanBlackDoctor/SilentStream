{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silentstream-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "www.silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "admin.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "agent.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m111.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m112.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m113.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "baek202.silentstream.win",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URI": "https://admin.silentstream.win",
    "DEVICE_BASE_URI": "https://agent.silentstream.win",
    "PACKAGE_KEY": "releases/v0.4.19/SilentStream-prepared-package-v0.4.19.zip",
    "PACKAGE_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.19/SilentStream-prepared-package-v0.4.19.zip",
    "PACKAGE_SHA256": "5ab1e33d2a475be380227a4de58ba3ba90997f66a143416f479666d6dbb9f4be",
    "PACKAGE_LENGTH": "798452877",
    "INSTALLER_KEY": "releases/v0.4.19/SilentStream-Central-Installer-v0.4.19.exe",
    "INSTALLER_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.19/SilentStream-Central-Installer-v0.4.19.exe",
    "INSTALLER_SHA256": "c5aecb440047be7fa5c0e59c5b7341e069518e6b2003cdd13f9e0d8f40fd42cf",
    "INSTALLER_LENGTH": "161832793",
    "GOOGLE_CLIENT_ID": "909291792658-um7mnfcnu8po4d36hs6n09q6inssc654.apps.googleusercontent.com",
    "BOOTSTRAP_OWNER_EMAIL": "alpaomegastartend@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
