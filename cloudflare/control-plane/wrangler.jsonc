{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silentstream-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "www.silentstream.win/*",
      "zone_name": "silentstream.win"
    },
    {
      "pattern": "admin.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "agent.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m111.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m112.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "m113.silentstream.win",
      "custom_domain": true
    },
    {
      "pattern": "baek202.silentstream.win",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URI": "https://admin.silentstream.win",
    "DEVICE_BASE_URI": "https://agent.silentstream.win",
    "PACKAGE_KEY": "releases/v0.4.21/SilentStream-prepared-package-v0.4.21.zip",
    "PACKAGE_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.21/SilentStream-prepared-package-v0.4.21.zip",
    "PACKAGE_SHA256": "a964bbbd029fab331b239b42335d544c45fc75cebf5decb3255b8ce11c4bd0d6",
    "PACKAGE_LENGTH": "798482179",
    "INSTALLER_KEY": "releases/v0.4.21/SilentStream-Central-Installer-v0.4.21.exe",
    "INSTALLER_URL": "https://github.com/JonathanBlackDoctor/SilentStream/releases/download/v0.4.21/SilentStream-Central-Installer-v0.4.21.exe",
    "INSTALLER_SHA256": "7cec6c36083b2a3f39643ff7029d05769d1e2aee3cf7b0fb5f320962ccf0b006",
    "INSTALLER_LENGTH": "161840985",
    "GOOGLE_CLIENT_ID": "909291792658-um7mnfcnu8po4d36hs6n09q6inssc654.apps.googleusercontent.com",
    "BOOTSTRAP_OWNER_EMAIL": "alpaomegastartend@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "YOUTUBE_REPLAY_ROOMS": "m111,m112,m113,baek202",
    "YOUTUBE_REPLAY_DISCOVERY": "true"
  }
}
